# examples/backup.service
# A backup service that skips itself while the 3D printer is busy.
# Install it as /etc/systemd/system/backup.service.
#
# The backup runs when the printer is idle. While it prints or is paused, layerlock exits
# 1 or 2, and systemd skips the unit. If layerlock can't get the printer state, it exits
# 255, and the unit fails. To run the backup anyway in that case, add --fail-open.

[Unit]
Description=Nightly backup (skips while printing)
After=network-online.target

[Service]
Type=oneshot
ExecCondition=/usr/local/bin/layerlock
ExecStart=/usr/bin/your-backup-script.sh

[Install]
WantedBy=multi-user.target
